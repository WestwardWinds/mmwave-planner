{
  "name": "mmwave-planner",
  "version": "0.1.0",
  "description": "3D coverage planner for mmWave presence sensors, packaged as the <mmwave-planner> web component.",
  "private": true,
  "type": "module",
  "main": "dist-lib/mmwave-planner.js",
  "module": "dist-lib/mmwave-planner.js",
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode lib",
    "build:site": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
